<Window x:Class="GlassMixer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Glass Mixer"
        Width="444" Height="660" MinWidth="320" MinHeight="280"
        ShowInTaskbar="False" Topmost="False" ResizeMode="CanResize" WindowStyle="None"
        WindowStartupLocation="Manual"
        Background="Transparent">

    <!-- WindowChrome removes the title bar. The 20px margin around the panel
         (MainWindow.Inset) is the window's resize border and the room the shadow needs. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="20"
                      UseAeroCaptionButtons="False"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <!-- Layers, bottom to top. The window itself is fully transparent (Native.SetGlass).
           1. this WPF content: only the soft shadow
           2. the blur, a composition visual added in code (GlassBackdrop.cs)
           3. the web page -->
    <Grid>
        <!-- The shadow of a black rounded rectangle. The rectangle itself hides under the blur;
             it is 1px smaller than the panel so its edge can never peek out at the corners.
             BlurRadius + ShadowDepth must stay within the 20px margin, or the shadow is cut
             off in a straight line with square corners. -->
        <Border x:Name="Shadow" Margin="21" CornerRadius="17" Background="Black" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="4" Direction="270" Opacity="0.5" RenderingBias="Quality" />
            </Border.Effect>
        </Border>

        <!-- The web page: the mixer UI itself. -->
        <wv2:WebView2 x:Name="Web" Margin="20" />
    </Grid>
</Window>
